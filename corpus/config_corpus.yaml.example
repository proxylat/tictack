# Corpus — system imaging config (scaffold: store + index + log only).
# Snake_case keys (UnderscoredNamingConvention), like TicTack's config.yaml.

# Chunk packs + manifests live here. Required.
store_path: '/var/lib/corpus/store'
# Windows: 'C:\ProgramData\Corpus\store'

# Chunk-index .db root. Empty = platform default
# (/var/lib/corpus, or C:\ProgramData\Corpus on Windows).
state_db_path: '/var/lib/corpus'

# Fixed chunk size for volume streams in MiB (1..64). PBS evidence says
# fixed suffices for guests; CDC only if shift-churn measurements say so.
chunk_mib: 4

compression:
  # zstd level 1..22. 3 = Veeam-High default, 1 = fast landing-zone tier.
  # Level 3 locked per item-9 curve (CompressionCurveTests): higher levels
  # gain ~0 bytes on realistic payloads, cost up to 90x encode.
  level: 3

# Post-capture full re-read verify costs ~50% of capture time (8 MiB vol,
# zstd 3, warm cache; measured by VerifyOverheadTests). Always on, no knob.

logging:
  level: info
  # Empty = corpus.log beside the exe.
  path: ''
  console: false

# GC retention: roots are the UNION of newest keep_last generations,
# snapshots imaged within keep_within_days (0 = off, by CreatedUtc),
# and explicitly pinned generations. Unknown pins warn and are ignored.
# GC runs on demand (--gc --confirm) or on schedule (--service, see gc_daily_at below); nothing is ever deleted implicitly.
retention:
  keep_last: 4
  keep_within_days: 0
  pin: []

# Exclusions (item 4): regenerable extents restored as zeros, names recorded
# per-snapshot in the manifest skip record. Omit = defaults below
# (pagefile/hiberfil/swapfile, $Recycle.Bin, System Volume Information,
# $UsnJrnl:$J, Windows\Temp, Temp). Explicit list REPLACES defaults, never
# merges. $LogFile is never excludable (stripped even if listed).
#exclusions:
#  skip: ['pagefile.sys', 'hiberfil.sys']

# Restore (recovery stick): --restore --snapshot <gen> --target <disk#|\\.\PhysicalDriveN|file>
# --confirm-type is required always (even --dry-run); a refused run names the want-TOKEN.
# Baked stick configs use store_path 'store' (resolved beside Corpus.exe); any other store via --store <path>.

# Per-pack encryption hook (Corpus ships zero builtin crypto): shell command
# with {input}/{output} substitution (same shape as TicTack jobs). Empty =
# stored unencrypted. Runs per sealed pack, never per chunk; a hook failure
# fails the job loud and deletes the plaintext pack.
#encrypt: 'age -r AGE-RECIPIENT -o "{output}" "{input}"'

# Scheduled GC/optimize cadence (service host only; manual --gc is unchanged).
#gc_daily_at: '02:00'
#optimize_every: '00:15:00'
