<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Corpus</AssemblyName>
    <RootNamespace>Corpus</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <!-- Segment-reader unit tests exercise VssReadStream over MemoryStream. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Corpus.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LTRData.DiscUtils.Vhdx" Version="1.0.90" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.9" />
    <!-- Compile-time only (same as TicTack): Roslyn rules, never ships. -->
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.259" PrivateAssets="all" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <None Include="recovery\assets\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- One-way source link: Corpus consumes TicTack utilities via the same
         Compile-Include pattern the test project uses. TicTack builds
         unchanged and never references Corpus. -->
    <Compile Include="../src/Interfaces.cs" Link="shared/Interfaces.cs" />
    <Compile Include="../src/PathUtil.cs" Link="shared/PathUtil.cs" />
    <Compile Include="../src/SqliteBootstrap.cs" Link="shared/SqliteBootstrap.cs" />
    <Compile Include="../src/Logging.cs" Link="shared/Logging.cs" />
    <Compile Include="../src/DesktopAlert.cs" Link="shared/DesktopAlert.cs" />
    <Compile Include="../src/ProcessRunner.cs" Link="shared/ProcessRunner.cs" />
  </ItemGroup>
</Project>
