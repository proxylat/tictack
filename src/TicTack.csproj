<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TicTackSv</AssemblyName>
    <RootNamespace>TicTack</RootNamespace>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.9" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.9" />
  </ItemGroup>
  <!-- .NET 10 SDK treats these as "type: platform" in deps.json but
       doesn't ship them in the shared framework. Force copy from NuGet cache. -->
  <Target Name="CopyWindowsRuntimePackages" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Copy SourceFiles="$(NuGetPackageRoot)system.serviceprocess.servicecontroller\10.0.9\runtimes\win\lib\net10.0\System.ServiceProcess.ServiceController.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)system.serviceprocess.servicecontroller\10.0.9\runtimes\win\lib\net10.0\System.ServiceProcess.ServiceController.dll')" />
    <Copy SourceFiles="$(NuGetPackageRoot)system.diagnostics.eventlog\10.0.9\runtimes\win\lib\net10.0\System.Diagnostics.EventLog.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)system.diagnostics.eventlog\10.0.9\runtimes\win\lib\net10.0\System.Diagnostics.EventLog.dll')" />
    <!-- native e_sqlite3.dll: CopyLocalLocksFileAssemblies only handles managed DLLs -->
    <Copy SourceFiles="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\2.1.11\runtimes\win-x64\native\e_sqlite3.dll"
          DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\2.1.11\runtimes\win-x64\native\e_sqlite3.dll')" />
  </Target>
</Project>
