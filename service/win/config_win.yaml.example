sources:
  - paths:
      - 'C:\Users\User\Desktop'
      - 'C:\Users\User\Pictures'
      - 'C:\Users\User\Videos'
      - 'C:\Users\User\Music'
      - 'C:\Users\User\Downloads'
    destination: '[TicTack]\Sync'
    state_db_path: 'C:\ProgramData\TicTack'
    debounce_seconds: 20
    filter:
      max_file_size_mb: no-limit
      exclude:
        - "*.iso"
        - "*.tmp"
        - "*.vmdk"
        - "*.crdownload"
        - "*.part"
        - "*.db-wal"
        - "*.db-shm"
        - "*.lock"
        - ".git/*"
        - ".opencode/*"
        - ".code-review-graph/*"
    sync:
      verification: date_and_size
      durability: full
      drain_strategy: scan
      dir_sync: per-file  # pair with durability: rename-only for the fast cold-sync combo (measured 3.5x); neutral under full
      complete_mode: inline  # inline = fsync on the copy worker; pipelined = one completer thread owns flush->rename->validate->upsert
      file_access: direct  # direct | vss (VSS snapshots for locked files, needs elevation, else falls back to direct)
      initial_sync_workers: 2
      retry:
        max_attempts: 5
        delay_ms: 1000
        backoff: 2.0
      lock_handling: retry
      retry_lock_minutes: 10
      delete_threshold_count: 1000
      delete_threshold_size_gb: 50
      delete_threshold_percent: 50
      delete_hold_days: 7
      versioning:
        max_versions: 10
        path: '[TicTack]\Sync\.versions'
      deletion:
        mode: archive
        path: '[TicTack]\Sync\.archive'

monitor:
  type: watcher # watcher | usn (NTFS journal, needs elevation, else falls back to watcher) | polling | composite
  watcher_buffer_kb: 1024
  polling_interval_seconds: 300
  restart_delay_seconds: 10

logging:
  level: info
  path: '[TicTack]\Sync\tictack.log'
  max_size_mb: 10
  max_files: 5
  console: false
  alert_path: 'C:\Users\User\Desktop'

watchdog:
  enabled: true
  interval_minutes: 30

external_drives:
  command: restic.exe backup --compression auto "{source}" -r "{drive}\restic-repo"
  require_marker_file: true
  marker_file_name: .tictack-target

jobs:
  - name: restic_archive
    time: "21:00"
    command: restic.exe backup --compression auto "{source}" -r D:\ResticRepo
    working_dir: C:\ProgramData\TicTack
