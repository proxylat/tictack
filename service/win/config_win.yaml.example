sources:
  - paths:
      - 'C:\Users\User\Desktop'
      - 'C:\Users\User\Pictures'
      - 'C:\Users\User\Videos'
      - 'C:\Users\User\Music'
      - 'C:\Users\User\Downloads'
    destination: '[TicTack]\Sync'
    state_db_path: 'C:\ProgramData\TicTack'
    debounce_seconds: 20
    filter:
      max_file_size_mb: no-limit
      exclude:
        - "*.iso"
        - "*.tmp"
        - "*.vmdk"
        - "*.crdownload"
        - "*.part"
        - "*.db-wal"
        - "*.db-shm"
        - "*.lock"
        - ".git/*"
        - ".opencode/*"
        - ".code-review-graph/*"
    sync:
      verification: date_and_size
      durability: full
      drain_strategy: scan
      dir_sync: per-file  # pair with durability: rename-only for the fast cold-sync combo (measured 3.5x); neutral under full
      complete_mode: inline  # inline = fsync on the copy worker; pipelined = one completer thread owns flush->rename->validate->upsert
      file_access: direct  # direct | vss (VSS snapshots for locked files, needs elevation, else falls back to direct)
      initial_sync_workers: 2
      retry:  # per-file copy retry (one file, seconds) — not the source lock
        max_attempts: 5
        delay_ms: 1000
        backoff: 2.0
      lock_handling: retry  # source lock: retry = wait / ignore = proceed without lock
      lock_wait_seconds: 600  # source lock: total wait budget before giving up
      delete_threshold_count: 1000
      delete_threshold_size_gb: 50
      delete_threshold_percent: 50
      delete_hold_days: 7
      # bulk_cleanup_percent: 80  # one folder owning >=80% of a 10+ file batch = cleanup, proceeds (absent = off)
      # full_routine_check_days: 14  # byte-compare everything this often; <=0 disables
      # spike_window_minutes: 60  # ransomware-shaped spikes freeze syncing until you delete .tictack-churn-hold
      # spike_bytes_gb: 100
      # spike_files: 50000
      # spike_renames: 10000
      # routine_check_days: 0  # periodic proof-by-restore sampling; 0 = off
      # routine_check_files: 10
      destination_protect: false  # service-only write ACLs on the backup drive; true = on, does not revert on false
      versioning:
        max_versions: 10
        path: '[TicTack]\Sync\.versions'
      deletion:
        mode: archive
        path: '[TicTack]\Sync\.archive'

monitor:
  type: watcher # watcher | usn (NTFS journal, needs elevation, else falls back to watcher) | polling | composite
  usn: false # composite-only: add the NTFS journal as a third member (needs elevation, else probe-skipped with a warning)
  watcher_buffer_kb: 1024
  polling_interval_seconds: 300
  polling_backstop: true # composite-only: false drops the polling member when the usn member is healthy (zero snapshot memory; gaps fire on-demand scans)
  restart_delay_seconds: 10
  usn_poll_interval_ms: 200 # idle sleep between USN journal reads (ms); larger = quieter idle, slower pickup
  usn_parent_prefilter: true # skip outside-tree journal records before any path resolve; false = resolve everything (more syscalls, same events)

logging:
  level: info
  path: '[TicTack]\Sync\tictack.log'
  max_size_mb: 10
  max_files: 5
  console: false
  alert_path: 'C:\Users\User\Desktop'

watchdog:
  enabled: true
  interval_minutes: 30

# Minutes to wait at startup for [VolumeLabel] volumes to appear (slow USB); 0 = resolve once, then fail fast
volume_wait_minutes: 2

external_drives:
  command: restic.exe backup --compression auto "{source}" -r "{drive}\restic-repo"
  require_marker_file: true
  marker_file_name: .tictack-target

jobs:
  - name: restic_archive
    time: "21:00"
    command: restic.exe backup --compression auto "{source}" -r D:\ResticRepo
    working_dir: C:\ProgramData\TicTack
    timeout_minutes: 60
  # Optional cadences: day = weekday name for weekly, day = 1-31 for monthly
  # (clamped to short months), run_once_on = ISO date that fires once.
  # - name: weekly_report
  #   schedule: weekly
  #   day: Sunday
  #   time: "08:00"
  #   command: report.exe
