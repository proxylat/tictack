sources:
  - paths:
      - '/home/user/Desktop'
      - '/home/user/Pictures'
      - '/home/user/Videos'
      - '/home/user/Music'
      - '/home/user/Downloads'
    destination: '/srv/tictack/Sync'
    state_db_path: '/var/lib/tictack'
    debounce_seconds: 20
    filter:
      max_file_size_mb: no-limit
      exclude:
        - "*.iso"
        - "*.tmp"
        - "*.vmdk"
        - "*.crdownload"
        - "*.part"
        - "*.db-wal"
        - "*.db-shm"
        - "*.lock"
        - ".git/*"
        - ".opencode/*"
        - ".code-review-graph/*"
    sync:
      verification: date_and_size
      durability: full
      drain_strategy: scan
      dir_sync: per-file  # pair with durability: rename-only for the fast cold-sync combo (measured 3.5x); neutral under full
      complete_mode: inline  # inline = fsync on the copy worker; pipelined = one completer thread owns flush->rename->validate->upsert
      initial_sync_workers: 2
      retry:  # per-file copy retry (one file, seconds) — not the source lock
        max_attempts: 5
        delay_ms: 1000
        backoff: 2.0
      lock_handling: retry  # source lock: retry = wait / ignore = proceed without lock
      lock_wait_seconds: 600  # source lock: total wait budget before giving up
      delete_threshold_count: 1000
      delete_threshold_size_gb: 50
      delete_threshold_percent: 50
      delete_hold_days: 7
      # bulk_cleanup_percent: 80  # one folder owning >=80% of a 10+ file batch = cleanup, proceeds (absent = off)
      # full_routine_check_days: 14  # byte-compare everything this often; <=0 disables
      # spike_window_minutes: 60  # ransomware-shaped spikes freeze syncing until you delete .tictack-churn-hold
      # spike_bytes_gb: 100
      # spike_files: 50000
      # spike_renames: 10000
      # routine_check_days: 0  # periodic proof-by-restore sampling; 0 = off
      # routine_check_files: 10
      destination_protect: false  # service-only write ACLs on the backup drive; true = on, does not revert on false
      versioning:
        max_versions: 10
        path: '/srv/tictack/Sync/.versions'
      deletion:
        mode: archive
        path: '/srv/tictack/Sync/.archive'

monitor:
  type: watcher
  watcher_buffer_kb: 1024
  polling_interval_seconds: 300
  polling_backstop: true # composite-only: false drops the polling member when the usn member is healthy (zero snapshot memory; gaps fire on-demand scans)
  restart_delay_seconds: 10

logging:
  level: info
  path: '/srv/tictack/Sync/tictack.log'
  max_size_mb: 10
  max_files: 5
  console: false
  alert_path: '/home/user/Desktop'

watchdog:
  enabled: true
  interval_minutes: 60

# Minutes to wait at startup for volumes to appear (slow USB); 0 = resolve once, then fail fast ([VolumeLabel] is Windows-only)
volume_wait_minutes: 2

external_drives:
  command: restic backup --compression auto "{source}" -r "{drive}/restic-repo"
  require_marker_file: true
  marker_file_name: .tictack-target

jobs:
  - name: restic_archive
    time: "21:00"
    command: restic backup --compression auto "{source}" -r /mnt/backup/ResticRepo
    working_dir: /opt/tictack
    timeout_minutes: 60
  # Optional cadences: day = weekday name for weekly, day = 1-31 for monthly
  # (clamped to short months), run_once_on = ISO date that fires once.
  # - name: weekly_report
  #   schedule: weekly
  #   day: Sunday
  #   time: "08:00"
  #   command: /opt/tictack/report.sh
