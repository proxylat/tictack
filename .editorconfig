# Meziantou.Analyzer tuning for TicTack.
# Default posture: every rule ON — a new warning fails nothing but is
# triaged (fix or justify here). The rules below are OFF because they
# conflict with deliberate project conventions; each carries its reason.

[*.cs]

# Grouped files are the convention (Interfaces.cs, Comparer.cs, ...).
dotnet_diagnostic.MA0048.severity = none # File name must match type name

# No SynchronizationContext in a service; ConfigureAwait everywhere is noise.
dotnet_diagnostic.MA0004.severity = none # Use Task.ConfigureAwait

# string == is already ordinal; string.Equals adds nothing.
dotnet_diagnostic.MA0006.severity = none # Use string.Equals instead of ==/!=

# InvariantGlobalization=true: current culture IS invariant, so the
# IFormatProvider overloads change no behavior.
dotnet_diagnostic.MA0011.severity = none # Format/ToString/TryParse provider

# YAML models expose List<T>; the serializer owns that surface.
dotnet_diagnostic.MA0016.severity = none # Collection abstraction over impl

# Method length is a review concern, not a build gate.
dotnet_diagnostic.MA0051.severity = none # Method is too long

# Lock modernization without a contention profile to justify touching
# locking code. Revisit if pstacks/syncblk ever implicate a lock.
dotnet_diagnostic.MA0158.severity = none # Use System.Threading.Lock

# CompositeMonitor re-raises child events with the ORIGINAL sender on
# purpose, so subscribers keep the true origin.
dotnet_diagnostic.MA0091.severity = none # Sender should be 'this'
